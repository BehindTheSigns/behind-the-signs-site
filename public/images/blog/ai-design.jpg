<svg width="800" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="ai-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#8b5cf6;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#ec4899;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#06b6d4;stop-opacity:1" />
    </linearGradient>
    <pattern id="dots" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
      <circle cx="10" cy="10" r="1" fill="white" opacity="0.2"/>
    </pattern>
  </defs>
  <rect width="800" height="400" fill="url(#ai-grad)" />
  <rect width="800" height="400" fill="url(#dots)" />
  <g transform="translate(400, 200)">
    <text x="0" y="-20" font-family="Arial Black, sans-serif" font-size="72" font-weight="900" fill="white" text-anchor="middle">AI</text>
    <text x="0" y="30" font-family="Arial, sans-serif" font-size="24" fill="white" text-anchor="middle" opacity="0.9">SIGN DESIGN</text>
  </g>
</svg>