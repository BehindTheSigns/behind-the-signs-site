<svg width="800" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="led-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3b82f6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ec4899;stop-opacity:1" />
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  <rect width="800" height="400" fill="#111827" />
  <text x="400" y="200" font-family="Arial Black, sans-serif" font-size="80" font-weight="900" fill="url(#led-grad)" text-anchor="middle" alignment-baseline="middle" filter="url(#glow)">LED</text>
  <text x="400" y="260" font-family="Arial, sans-serif" font-size="20" fill="#ec4899" text-anchor="middle" opacity="0.8">CHANNEL LETTERS</text>
</svg>