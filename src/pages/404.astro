---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="404 - Page Not Found" 
  description="The page you're looking for doesn't exist. Let's get you back on track."
>
  <section class="min-h-screen flex items-center justify-center py-20 px-4">
    <div class="container-custom text-center">
      <div class="max-w-2xl mx-auto">
        <!-- 404 Visual -->
        <div class="mb-8">
          <h1 class="text-8xl md:text-9xl font-black text-transparent bg-gradient-to-r from-pink-500 to-yellow-400 bg-clip-text animate-pulse-slow">
            404
          </h1>
          <div class="text-2xl md:text-3xl font-bold text-slate-900 mt-4">
            Sign Not Found
          </div>
        </div>

        <!-- Message -->
        <p class="text-lg text-slate-600 mb-8 leading-relaxed">
          Looks like this sign has been taken down! The page you're looking for doesn't exist or has been moved.
        </p>

        <!-- Search Suggestion -->
        <div class="bg-slate-100 rounded-xl p-6 mb-8">
          <p class="text-slate-700 mb-4">
            Here are some helpful links to get you back on track:
          </p>
          <div class="grid sm:grid-cols-2 gap-4">
            <a href="/" class="block p-4 bg-white rounded-lg hover:shadow-lg transition-shadow">
              <svg class="w-6 h-6 text-teal-600 mb-2 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
              </svg>
              <div class="font-semibold text-slate-900">Home Page</div>
              <div class="text-sm text-slate-600">Start from the beginning</div>
            </a>

            <a href="/#podcast" class="block p-4 bg-white rounded-lg hover:shadow-lg transition-shadow">
              <svg class="w-6 h-6 text-pink-600 mb-2 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                <path d="M18 3a1 1 0 00-1.196-.98l-10 2A1 1 0 006 5v9.114A4.369 4.369 0 005 14c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2V7.82l8-1.6v5.894A4.37 4.37 0 0015 12c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2V3z"/>
              </svg>
              <div class="font-semibold text-slate-900">Latest Episodes</div>
              <div class="text-sm text-slate-600">Listen to our podcast</div>
            </a>

            <a href="/#blog" class="block p-4 bg-white rounded-lg hover:shadow-lg transition-shadow">
              <svg class="w-6 h-6 text-yellow-500 mb-2 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M2 5a2 2 0 012-2h8a2 2 0 012 2v10a2 2 0 002 2H4a2 2 0 01-2-2V5zm3 1h6v4H5V6zm6 6H5v2h6v-2z" clip-rule="evenodd"/>
                <path d="M15 7h1a2 2 0 012 2v5.5a1.5 1.5 0 01-3 0V7z"/>
              </svg>
              <div class="font-semibold text-slate-900">Blog Articles</div>
              <div class="text-sm text-slate-600">Read industry insights</div>
            </a>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/" class="btn-primary">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
            </svg>
            Go Back Home
          </a>
          <a href="/#subscribe" class="btn-secondary">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
            </svg>
            Get the Newsletter
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>