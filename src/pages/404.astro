---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="That page doesn't exist. Head back to Behind the Signs."
  noindex
>
  <section class="section-white">
    <div class="container-custom flex max-w-xl flex-col items-center py-24 text-center">
      <p class="eyebrow-gold">404</p>
      <h1 class="headline text-4xl sm:text-5xl mt-3">Sign Not Found</h1>
      <p class="lead mt-4">
        Looks like this sign has been taken down. The page you're looking for doesn't exist or has
        moved.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary">Back to the Homepage</a>
        <a href="/#subscribe" class="btn-secondary">Get the Newsletter</a>
      </div>
    </div>
  </section>
</BaseLayout>
