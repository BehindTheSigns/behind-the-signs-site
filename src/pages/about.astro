---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

const timeline = [
  { year: '1994', title: 'Started in the Sign Industry', description: 'Began journey as an apprentice, learning the fundamentals of sign craftsmanship from master craftsmen.' },
  { year: '2000', title: 'Opened First Sign Shop', description: 'Launched independent sign shop, focusing on quality craftsmanship and customer relationships.' },
  { year: '2010', title: 'Embraced Digital Revolution', description: 'Pioneered adoption of digital printing and LED technology in our region, transforming production capabilities.' },
  { year: '2018', title: 'Started Sharing Knowledge', description: 'Began mentoring other sign professionals and sharing industry insights through social media.' },
  { year: '2023', title: 'Launched Behind the Signs', description: 'Created podcast and content platform to elevate the entire sign industry through education and community.' },
];

const values = [
  { 
    title: 'Craftsmanship First', 
    description: 'Quality isn\'t just about the final product—it\'s about the pride we take in every step of the process.',
    icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z'
  },
  { 
    title: 'Community Over Competition', 
    description: 'When we share knowledge and support each other, the entire industry rises together.',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z'
  },
  { 
    title: 'Never Stop Learning', 
    description: 'The sign industry evolves daily. Stay curious, embrace new technologies, and always be a student.',
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253'
  },
];
---

<BaseLayout 
  title="About - Behind the Signs" 
  description="Learn about our 30+ year journey in the sign industry and our mission to elevate sign professionals worldwide."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-gray-900 via-pink-900/20 to-gray-900 py-20">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl font-bold text-white mb-6 font-['Bebas_Neue'] tracking-wider">
          30+ Years of Sign Excellence
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed">
          From apprentice to industry leader, our journey has been about more than making signs—it's about building a community that elevates the entire industry.
        </p>
      </div>
    </div>
  </section>

  <!-- Founder Story -->
  <section class="py-16">
    <div class="container-custom">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-4xl font-bold mb-6 font-['Bebas_Neue'] text-gray-900">
            The Story Behind <span class="text-pink-500">Behind the Signs</span>
          </h2>
          <div class="space-y-4 text-gray-600">
            <p>
              Three decades ago, I started as an apprentice in a small sign shop, mesmerized by the transformation of raw materials into powerful visual communication. What began as a job quickly became a passion that would define my life's work.
            </p>
            <p>
              Through economic ups and downs, technological revolutions, and industry transformations, one thing remained constant: the incredible community of sign professionals who share their knowledge, support each other, and push the boundaries of what's possible.
            </p>
            <p>
              Behind the Signs was born from a simple belief: when we share our experiences, challenges, and victories, we all grow stronger. This platform isn't just about my journey—it's about celebrating and elevating every sign professional who turns blank canvases into meaningful connections.
            </p>
            <p>
              Today, through our podcast, blog, and community initiatives, we're building something bigger than any single shop or business. We're creating a movement that recognizes sign making as both an art and a science, deserving of respect, fair pricing, and continuous innovation.
            </p>
          </div>
        </div>
        <div class="relative">
          <div class="aspect-square bg-gradient-to-br from-yellow-400 to-pink-500 rounded-2xl opacity-10 absolute inset-0"></div>
          <div class="relative p-12">
            <div class="text-center">
              <div class="text-9xl font-bold text-pink-500 font-['Bebas_Neue'] mb-4">30+</div>
              <div class="text-2xl text-gray-700 font-semibold">Years of Experience</div>
              <div class="text-lg text-gray-600 mt-2">Thousands of Signs Created</div>
              <div class="text-lg text-gray-600">Hundreds of Businesses Transformed</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-16 bg-gray-50">
    <div class="container-custom">
      <h2 class="text-4xl font-bold text-center mb-12 font-['Bebas_Neue'] text-gray-900">
        Our Journey
      </h2>
      <div class="max-w-4xl mx-auto">
        <div class="relative">
          <!-- Timeline line -->
          <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-gradient-to-b from-yellow-400 via-pink-500 to-yellow-400"></div>
          
          <!-- Timeline items -->
          {timeline.map((item, index) => (
            <div class="relative flex items-start mb-12 group">
              <div class="absolute left-8 w-4 h-4 bg-pink-500 rounded-full -translate-x-1/2 group-hover:scale-150 transition-transform"></div>
              <div class="ml-20">
                <div class="text-yellow-500 font-bold text-sm mb-1">{item.year}</div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">{item.title}</h3>
                <p class="text-gray-600">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Values -->
  <section class="py-16">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold mb-4 font-['Bebas_Neue'] text-gray-900">
          Our Mission & Values
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          We exist to elevate the sign industry through education, community building, and sharing decades of hard-earned wisdom.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {values.map((value) => (
          <div class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow">
            <div class="w-12 h-12 bg-gradient-to-br from-yellow-400 to-pink-500 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={value.icon}></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3 text-gray-900">{value.title}</h3>
            <p class="text-gray-600">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Behind the Signs Exists -->
  <section class="py-16 bg-gradient-to-r from-pink-500 to-yellow-400">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center text-white">
        <h2 class="text-4xl font-bold mb-8 font-['Bebas_Neue']">
          Why Behind the Signs Exists
        </h2>
        <div class="space-y-6 text-lg">
          <p>
            Too many talented sign professionals struggle in isolation, reinventing wheels that have already been perfected, and undervaluing their expertise.
          </p>
          <p>
            We're here to change that. Through honest conversations, practical insights, and real-world case studies, we're building a resource that would have saved me years of trial and error.
          </p>
          <p class="text-xl font-semibold">
            Our goal is simple: Help every sign professional build a more profitable, sustainable, and fulfilling business while advancing the craft we all love.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Impact Stats -->
  <section class="py-16">
    <div class="container-custom">
      <h2 class="text-4xl font-bold text-center mb-12 font-['Bebas_Neue'] text-gray-900">
        Our Industry Impact
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-4xl font-bold text-pink-500 mb-2">100+</div>
          <div class="text-gray-600">Podcast Episodes</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-yellow-500 mb-2">50K+</div>
          <div class="text-gray-600">Monthly Listeners</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-pink-500 mb-2">500+</div>
          <div class="text-gray-600">Industry Connections</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-yellow-500 mb-2">1M+</div>
          <div class="text-gray-600">Signs Inspired</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-gray-900">
    <div class="container-custom">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-4xl font-bold text-white mb-6 font-['Bebas_Neue']">
          Join Our Mission
        </h2>
        <p class="text-gray-300 mb-8">
          Whether you're just starting out or have decades of experience, you belong in our community. Let's elevate the sign industry together.
        </p>
        <div class="max-w-md mx-auto">
          <NewsletterForm 
            variant="inline"
            buttonText="Join the Community"
            placeholder="Your email address"
          />
        </div>
        <div class="mt-8 flex justify-center space-x-6">
          <a href="/podcast" class="text-yellow-400 hover:text-yellow-300 font-semibold">
            Listen to the Podcast →
          </a>
          <a href="/blog" class="text-yellow-400 hover:text-yellow-300 font-semibold">
            Read the Blog →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>