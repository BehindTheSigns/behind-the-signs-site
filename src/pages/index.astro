                  class="grid h-11 w-11 place-items-center rounded-full bg-slate-100 transition-colors hover:bg-pink-500 group"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5 fill-slate-600 group-hover:fill-white transition-colors">
                    <path d={social.icon} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>

        <p class="text-slate-400 text-sm mt-10">© 2026 Behind the Signs. All rights reserved.</p>
      </div>
