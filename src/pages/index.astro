---
import '../styles/global.css';
import { Image } from 'astro:assets';
import heroBg from '../assets/coming-soon/hero-bg.jpg';
import wordmark from '../assets/coming-soon/wordmark.svg';
import tilePodcast from '../assets/coming-soon/tile-podcast.png';
import tileShopTours from '../assets/coming-soon/tile-shop-tours.png';
import tileCommunity from '../assets/coming-soon/tile-community.png';

const links = [
  {
    href: 'https://www.youtube.com/playlist?list=PLWFiBORpfpiAlcKW7w-zNKCetpwtm1ckk',
    label: 'Watch the Behind the Signs Podcast on YouTube',
    image: tilePodcast,
    alt: 'Behind the Signs Podcast with Liz Toynes and Joe Arenella — Elevating The Sign Industry Together',
  },
  {
    href: 'https://www.youtube.com/playlist?list=PLWFiBORpfpiB1tOaQVYl2_9JO0PXCT3xg',
    label: 'Watch Behind the Signs Shop Tours on YouTube',
    image: tileShopTours,
    alt: 'Behind the Signs Shop Tours — Celebrating The People & Their Work',
  },
  {
    href: 'https://www.facebook.com/groups/behindthesigns',
    label: 'Join the Behind the Signs Facebook Community',
    image: tileCommunity,
    alt: 'Join the conversation — Behind the Signs Facebook Community',
  },
];

const description =
  'Behind the Signs — Elevating the sign industry together. Full site coming soon. Watch the podcast and shop tours on YouTube, and join our Facebook community.';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>Behind the Signs | Coming Soon</title>
    <meta name="description" content={description} />
    <!-- PREVENT INDEXING - WORK IN PROGRESS SITE -->
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Behind the Signs | Coming Soon" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og-coming-soon.jpg', Astro.site)} />
    <meta property="og:site_name" content="Behind the Signs" />
    <meta property="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@500;700;900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-[#018bb7] min-h-screen">
    <main>
      <!-- Hero: sticker-print photo under a teal wash, brand wordmark, Coming Soon -->
      <section class="relative overflow-hidden">
        <div class="absolute inset-0 hero-zoom">
          <Image
            src={heroBg}
            alt=""
            class="w-full h-full object-cover saturate-[.75]"
            loading="eager"
            widths={[768, 1280, 1920, 2560]}
            sizes="100vw"
          />
        </div>
        <!-- Teal wash + fade into the flat band below -->
        <div class="absolute inset-0 bg-[#018bb7]/50"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#018bb7]"></div>

        <div class="relative flex flex-col items-center px-6 pt-14 pb-24 sm:pt-20 sm:pb-32 lg:pt-24 lg:pb-40">
          <img
            src={wordmark.src}
            alt="Behind the Signs"
            class="wordmark-in w-[82vw] max-w-[320px] sm:max-w-[480px] lg:max-w-[630px] h-auto"
          />
          <h1
            class="coming-soon-in text-white font-black text-4xl sm:text-6xl lg:text-7xl tracking-tight mt-10 sm:mt-14 lg:mt-16 drop-shadow-[0_3px_10px_rgba(0,40,55,0.45)]"
          >
            Coming Soon
          </h1>
        </div>
      </section>

      <!-- The three destinations -->
      <section aria-label="Where to find us" class="relative px-6 pb-14 sm:pb-16 -mt-8 sm:-mt-12">
        <ul class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-6 lg:gap-12 list-none p-0">
          {
            links.map((link, i) => (
              <li class={`tile-in tile-in-${i}`}>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={link.label}
                  class="tile group block focus-visible:outline-none"
                >
                  <Image
                    src={link.image}
                    alt={link.alt}
                    class="w-full h-auto block max-w-[420px] mx-auto"
                    widths={[420, 840]}
                    sizes="(min-width: 640px) 33vw, 90vw"
                    loading="eager"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>

    <style>
      html {
        font-family: 'Roboto', sans-serif;
      }

      .tile {
        box-shadow: 0 14px 34px rgba(0, 35, 48, 0.35);
        transition:
          transform 0.25s ease,
          box-shadow 0.25s ease;
        max-width: 420px;
        margin-inline: auto;
      }

      .tile:hover,
      .tile:focus-visible {
        transform: translateY(-6px) scale(1.02);
        box-shadow:
          0 22px 44px rgba(0, 35, 48, 0.45),
          0 0 0 4px rgba(255, 255, 255, 0.35);
      }

      .tile:active {
        transform: translateY(-2px) scale(1.005);
      }

      /* Entrance choreography */
      .hero-zoom {
        animation: hero-zoom 2s ease-out both;
      }

      .wordmark-in {
        animation: drop-in 0.7s cubic-bezier(0.34, 1.4, 0.64, 1) both;
        filter: drop-shadow(0 8px 18px rgba(0, 40, 55, 0.35));
      }

      .coming-soon-in {
        animation: rise-in 0.7s ease-out 0.3s both;
      }

      .tile-in {
        animation: rise-in 0.7s ease-out both;
      }
      .tile-in-0 { animation-delay: 0.5s; }
      .tile-in-1 { animation-delay: 0.65s; }
      .tile-in-2 { animation-delay: 0.8s; }

      @keyframes hero-zoom {
        from { transform: scale(1.06); }
        to { transform: scale(1); }
      }

      @keyframes drop-in {
        from {
          opacity: 0;
          transform: translateY(-28px) scale(0.94);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      @keyframes rise-in {
        from {
          opacity: 0;
          transform: translateY(22px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .hero-zoom,
        .wordmark-in,
        .coming-soon-in,
        .tile-in {
          animation: none;
        }
        .tile,
        .tile:hover,
        .tile:focus-visible {
          transition: none;
          transform: none;
        }
      }
    </style>
  </body>
</html>
