    <!-- ============ FOOTER — subscribe + socials, nothing else ============ -->
    <footer id="subscribe" class="section-white border-t border-slate-200 scroll-mt-24">
      <div class="container-custom max-w-2xl flex flex-col items-center text-center pt-16 sm:pt-20 pb-10">
        <img src={wordmarkInk.src} alt="" class="h-16 sm:h-20 w-auto" />
        <h2 class="headline text-2xl sm:text-3xl mt-8">Get the newsletter</h2>
        <p class="lead mt-3 max-w-md">
          One long-form article a month, plus the latest episodes and Shop Tours. No fluff.
        </p>

        <form
          name="subscribe"
          method="POST"
          action="/thanks"
          data-netlify="true"
          netlify-honeypot="bot-field"
