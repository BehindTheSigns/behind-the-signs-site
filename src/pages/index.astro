    <style>
      /* Cabinet links deepen their shadow on hover — no movement */
      .dest .panel-cabinet {
        transition: box-shadow 0.2s ease;
      }
      .dest:hover .panel-cabinet,
      .dest:focus-visible .panel-cabinet {
        box-shadow: var(--shadow-sticker-lg);
      }
    </style>

    <script>
      // Mobile nav: hamburger toggles the dropdown; any link tap closes it.
      const toggle = document.getElementById('nav-toggle')!;
      const menu = document.getElementById('nav-menu')!;
      const setMenu = (open: boolean) => {
        menu.classList.toggle('hidden', !open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        toggle.querySelector('[data-icon-open]')!.classList.toggle('hidden', open);
        toggle.querySelector('[data-icon-close]')!.classList.toggle('hidden', !open);
      };
      toggle.addEventListener('click', () => setMenu(menu.classList.contains('hidden')));
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

      // Nav wordmark stays hidden while the big hero wordmark is on screen,
      // then fades in once it scrolls under the bar.
      const brand = document.getElementById('nav-brand')!;
      const heroMark = document.getElementById('hero-wordmark');
      if (heroMark && 'IntersectionObserver' in window) {
        new IntersectionObserver(
          ([entry]) => {
            const hide = entry.isIntersecting;
            brand.classList.toggle('opacity-0', hide);
            brand.classList.toggle('pointer-events-none', hide);
          },
          { rootMargin: '-64px 0px 0px 0px' }
        ).observe(heroMark);
      } else {
        brand.classList.remove('opacity-0', 'pointer-events-none');
      }
    </script>

    <script>
      // Subscribe form: lock the button on first submit so a double click can't
      // post twice, and show a spinner so the click visibly did something.
      const form = document.querySelector<HTMLFormElement>('form[name="subscribe"]');
      const button = form?.querySelector<HTMLButtonElement>('[data-subscribe-submit]');
      if (form && button) {
        const spinner = button.querySelector<HTMLElement>('[data-spinner]')!;
        const label = button.querySelector<HTMLElement>('[data-label]')!;
        const email = form.querySelector<HTMLInputElement>('input[name="email"]')!;
        let resetTimer: number | undefined;

        const setBusy = (busy: boolean) => {
          button.disabled = busy;
          button.setAttribute('aria-busy', String(busy));
          spinner.classList.toggle('hidden', !busy);
          label.textContent = busy ? 'Subscribing…' : 'Subscribe';
          email.readOnly = busy;
          form.dataset.submitting = busy ? 'true' : '';
          window.clearTimeout(resetTimer);
          // Safety valve: if the network hangs and we never navigate away,
          // give the button back after 20s so the user isn't stuck.
          if (busy) resetTimer = window.setTimeout(() => setBusy(false), 20000);
        };

        form.addEventListener('submit', (event) => {
          if (form.dataset.submitting) {
            event.preventDefault();
            return;
          }
          setBusy(true);
        });

        // Coming back via the back button can restore the page from bfcache
        // with the busy state still applied — undo it.
        window.addEventListener('pageshow', (event) => {
          if (event.persisted) setBusy(false);
        });
      }
    </script>

    <script>
      // Click-to-play video facades: thumbnails link to YouTube (no-JS fallback)
      // and upgrade to an in-place privacy-enhanced embed when JS is available.
      document.querySelectorAll<HTMLAnchorElement>('[data-video-embed]').forEach((thumb) => {
        thumb.addEventListener('click', (event) => {
          event.preventDefault();
          const { videoId, videoTitle } = thumb.dataset;
          const holder = document.createElement('div');
          holder.className = 'relative aspect-video';
          const frame = document.createElement('iframe');
          frame.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
          frame.title = videoTitle || 'YouTube video';
          frame.allow =
            'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
          frame.allowFullscreen = true;
          frame.className = 'absolute inset-0 h-full w-full';
          holder.appendChild(frame);
          thumb.replaceWith(holder);
        });
      });
    </script>
  </body>
</html>
