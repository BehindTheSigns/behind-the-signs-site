---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import BlogCard from '../components/BlogCard.astro';
import PodcastCard from '../components/PodcastCard.astro';

// Sample data - will be replaced with actual content collections
const featuredPodcasts = [
  {
    title: "The Future of Digital Signage with Tech Innovator Mike Chen",
    description: "Explore cutting-edge technologies transforming the sign industry, from AR displays to AI-powered design tools.",
    episode: 98,
    pubDate: new Date('2024-01-15'),
    youtubeId: 'dQw4w9WgXcQ',
    duration: '45:23',
    guest: 'Mike Chen'
  },
  {
    title: "Building a Million-Dollar Sign Business from Scratch",
    description: "Sarah Johnson shares her journey from a garage startup to running one of the midwest's most successful sign companies.",
    episode: 97,
    pubDate: new Date('2024-01-08'),
    youtubeId: 'dQw4w9WgXcQ',
    duration: '52:17',
    guest: 'Sarah Johnson'
  },
  {
    title: "Mastering Vehicle Wraps: Tips from the Pros",
    description: "Industry veterans reveal their secrets for perfect vehicle wrap installations every time.",
    episode: 96,
    pubDate: new Date('2024-01-01'),
    youtubeId: 'dQw4w9WgXcQ',
    duration: '38:45',
    guest: 'Tom Rodriguez'
  }
];

const featuredPosts = [
  {
    title: "5 Pricing Strategies That Doubled Our Sign Shop Revenue",
    description: "Learn the exact pricing framework we used to transform our margins and grow our business without losing customers.",
    pubDate: new Date('2024-01-18'),
    category: 'business-tips',
    slug: 'pricing-strategies-sign-shop',
    image: '/images/blog/800x450.jpg',
    tags: ['pricing', 'business', 'growth']
  },
  {
    title: "The Complete Guide to LED Channel Letters",
    description: "Everything you need to know about designing, fabricating, and installing LED channel letters for maximum impact.",
    pubDate: new Date('2024-01-12'),
    category: 'technical-guides',
    slug: 'led-channel-letters-guide',
    image: '/images/blog/800x450.jpg',
    tags: ['LED', 'fabrication', 'tutorial']
  },
  {
    title: "How AI is Revolutionizing Sign Design in 2024",
    description: "Discover the AI tools that are changing how we create, iterate, and present sign designs to clients.",
    pubDate: new Date('2024-01-05'),
    category: 'industry-news',
    slug: 'ai-sign-design-2024',
    image: '/images/blog/800x450.jpg',
    tags: ['AI', 'technology', 'design']
  }
];
---

<BaseLayout title="Home" description="Behind the Signs - Elevating the sign industry through expert conversations, insights, and 30+ years of experience">
  <Hero />

  <!-- Featured Podcasts Section -->
  <section class="py-16 lg:py-20 bg-slate-50">
    <div class="container-custom">
      <div class="text-center mb-12">
        <span class="text-pink-500 font-bold text-sm uppercase tracking-wider">Latest Episodes</span>
        <h2 class="text-4xl md:text-5xl font-bold mt-2 mb-4 font-['Bebas_Neue'] text-slate-800">
          Fresh from the <span class="text-gradient">Studio</span>
        </h2>
        <p class="text-slate-600 max-w-2xl mx-auto">
          Dive into conversations with industry leaders, innovators, and successful sign business owners.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mb-10">
        {featuredPodcasts.map((podcast) => (
          <PodcastCard {...podcast} />
        ))}
      </div>

      <div class="text-center">
        <a href="/podcast" class="btn-primary">
          View All Episodes
        </a>
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="py-16 lg:py-20 hero-bg bokeh-bg">
    <div class="container-custom relative-content">
      <div class="bg-white/5 backdrop-blur-sm rounded-3xl p-8 md:p-12 border border-white/10">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4 font-['Bebas_Neue']">
            Join 10,000+ Sign Professionals
          </h2>
          <p class="text-white/80 text-lg mb-8">
            Get weekly insights, industry trends, and exclusive tips delivered straight to your inbox.
            No spam, just value.
          </p>
          <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
            <input
              type="email"
              placeholder="Enter your email"
              required
              class="flex-1 px-6 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-transparent"
            />
            <button type="submit" class="btn-primary">
              Subscribe Now
            </button>
          </form>
          <p class="text-white/50 text-sm mt-4">
            Unsubscribe anytime. We respect your privacy.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Blog Posts -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <span class="text-pink-500 font-bold text-sm uppercase tracking-wider">From the Blog</span>
        <h2 class="text-4xl md:text-5xl font-bold mt-2 mb-4 font-['Bebas_Neue'] text-slate-800">
          Industry <span class="text-gradient">Insights</span>
        </h2>
        <p class="text-slate-600 max-w-2xl mx-auto">
          Practical tips, technical guides, and business strategies to help you succeed in the sign industry.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mb-10">
        {featuredPosts.map((post) => (
          <BlogCard {...post} />
        ))}
      </div>

      <div class="text-center">
        <a href="/blog" class="btn-highlight">
          Read More Articles
        </a>
      </div>
    </div>
  </section>

  <!-- About/Features Section -->
  <section class="py-16 lg:py-20 bg-slate-50">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-pink-500 font-bold text-sm uppercase tracking-wider">Why Behind the Signs?</span>
          <h2 class="text-4xl md:text-5xl font-bold mt-2 mb-6 font-['Bebas_Neue'] text-slate-800">
            30+ Years of <span class="text-gradient">Sign Industry Excellence</span>
          </h2>
          <p class="text-slate-600 text-lg mb-8">
            Behind the Signs isn't just another podcast—it's a movement to elevate the entire sign industry.
            With over three decades of hands-on experience in design, fabrication, and business management,
            we bring you real insights that work.
          </p>

          <div class="space-y-5">
            <div class="flex items-start">
              <div class="flex-shrink-0 w-12 h-12 bg-yellow-400 rounded-xl flex items-center justify-center shadow-lg shadow-yellow-400/30">
                <svg class="w-6 h-6 text-slate-900" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/>
                  <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 1 1 0 000 2H6a2 2 0 100 4h2a2 2 0 100-4h-.5a1 1 0 000-2H8a2 2 0 012 2v11a2 2 0 11-4 0V5z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-xl font-bold text-slate-800 mb-1">Expert Interviews</h3>
                <p class="text-slate-500">Learn from successful sign shop owners and industry innovators.</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="flex-shrink-0 w-12 h-12 bg-pink-500 rounded-xl flex items-center justify-center shadow-lg shadow-pink-500/30">
                <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M6 6V5a3 3 0 013-3h2a3 3 0 013 3v1h2a2 2 0 012 2v3.57A22.952 22.952 0 0110 13a22.95 22.95 0 01-8-1.43V8a2 2 0 012-2h2zm2-1a1 1 0 011-1h2a1 1 0 011 1v1H8V5zm1 5a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1z" clip-rule="evenodd"/>
                  <path d="M2 13.692V16a2 2 0 002 2h12a2 2 0 002-2v-2.308A24.974 24.974 0 0110 15c-2.796 0-5.487-.46-8-1.308z"/>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-xl font-bold text-slate-800 mb-1">Business Growth</h3>
                <p class="text-slate-500">Proven strategies to scale your sign business and increase profits.</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="flex-shrink-0 w-12 h-12 bg-cyan-500 rounded-xl flex items-center justify-center shadow-lg shadow-cyan-500/30">
                <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"/>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-xl font-bold text-slate-800 mb-1">Technical Mastery</h3>
                <p class="text-slate-500">Deep dives into fabrication techniques and material innovations.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="bg-slate-900 rounded-2xl p-8 text-white overflow-hidden">
            <!-- Subtle bokeh effect -->
            <div class="absolute inset-0 opacity-30">
              <div class="absolute top-0 right-0 w-32 h-32 bg-cyan-500 rounded-full blur-3xl"></div>
              <div class="absolute bottom-0 left-0 w-40 h-40 bg-pink-500 rounded-full blur-3xl"></div>
            </div>

            <div class="relative">
              <h3 class="text-3xl font-bold mb-4 font-['Bebas_Neue']">Join Our Community</h3>
              <p class="text-white/70 mb-6">
                Connect with thousands of sign professionals sharing knowledge, opportunities, and support.
              </p>
              <div class="space-y-3">
                <a href="#" class="flex items-center justify-between p-3 bg-white/5 border border-white/10 rounded-lg hover:bg-white/10 hover:border-white/20 transition-all">
                  <span class="font-semibold">Facebook Group</span>
                  <span class="text-cyan-400 text-sm">15K+ Members</span>
                </a>
                <a href="#" class="flex items-center justify-between p-3 bg-white/5 border border-white/10 rounded-lg hover:bg-white/10 hover:border-white/20 transition-all">
                  <span class="font-semibold">YouTube Channel</span>
                  <span class="text-cyan-400 text-sm">25K+ Subscribers</span>
                </a>
                <a href="#" class="flex items-center justify-between p-3 bg-white/5 border border-white/10 rounded-lg hover:bg-white/10 hover:border-white/20 transition-all">
                  <span class="font-semibold">Newsletter</span>
                  <span class="text-cyan-400 text-sm">10K+ Readers</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Decorative neon accents -->
          <div class="absolute -top-2 -right-2 w-16 h-16 bg-pink-500 rounded-full blur-xl opacity-40"></div>
          <div class="absolute -bottom-2 -left-2 w-20 h-20 bg-cyan-500 rounded-full blur-xl opacity-40"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <span class="text-pink-500 font-bold text-sm uppercase tracking-wider">Testimonials</span>
        <h2 class="text-4xl md:text-5xl font-bold mt-2 mb-4 font-['Bebas_Neue'] text-slate-800">
          What the <span class="text-gradient">Community Says</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
        <div class="bg-slate-50 rounded-xl p-6 border border-slate-100 hover:border-pink-200 transition-colors">
          <div class="flex mb-4">
            {[...Array(5)].map(() => (
              <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <p class="text-slate-600 mb-4">
            "Behind the Signs has transformed how I approach my business. The pricing strategies alone increased our revenue by 40% in 6 months."
          </p>
          <div class="font-bold text-slate-800">John Martinez</div>
          <div class="text-sm text-slate-500">Owner, Martinez Signs</div>
        </div>

        <div class="bg-slate-50 rounded-xl p-6 border border-slate-100 hover:border-pink-200 transition-colors">
          <div class="flex mb-4">
            {[...Array(5)].map(() => (
              <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <p class="text-slate-600 mb-4">
            "The technical guides are incredibly detailed. I've learned more in 3 months than in my previous 5 years in the industry."
          </p>
          <div class="font-bold text-slate-800">Sarah Chen</div>
          <div class="text-sm text-slate-500">Lead Designer, Bright Signs Co.</div>
        </div>

        <div class="bg-slate-50 rounded-xl p-6 border border-slate-100 hover:border-pink-200 transition-colors">
          <div class="flex mb-4">
            {[...Array(5)].map(() => (
              <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <p class="text-slate-600 mb-4">
            "Every episode is packed with actionable insights. It's like having a mentor who's been through it all."
          </p>
          <div class="font-bold text-slate-800">Mike Thompson</div>
          <div class="text-sm text-slate-500">Founder, Thompson Graphics</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 lg:py-20 relative overflow-hidden">
    <!-- Background with sign board aesthetic -->
    <div class="absolute inset-0 sign-board"></div>
    <div class="absolute inset-0 bg-gradient-to-br from-pink-600/90 to-pink-500/90"></div>

    <div class="container-custom relative text-center">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 font-['Bebas_Neue']">
        Ready to Elevate Your Sign Business?
      </h2>
      <p class="text-white/90 text-lg mb-8 max-w-2xl mx-auto">
        Join thousands of sign professionals who are transforming their businesses with Behind the Signs.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/podcast" class="btn-highlight text-lg">
          Start Listening
        </a>
        <a href="/blog" class="px-6 py-3 bg-white/20 backdrop-blur-sm text-white font-bold rounded-lg hover:bg-white/30 transition-all border border-white/30 hover:border-white/50 text-lg">
          Explore the Blog
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
