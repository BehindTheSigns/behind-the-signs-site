---
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';
import { Image } from 'astro:assets';
import { getPublishedPosts } from '../lib/content';
import heroBg from '../assets/coming-soon/hero-bg.jpg';
import wordmark from '../assets/coming-soon/wordmark.svg';
import wordmarkInk from '../assets/wordmark-ink.svg';
import hostJoe from '../assets/landing/host-joe.jpg';
import hostLiz from '../assets/landing/host-liz.jpg';
import { fetchLatestVideos } from '../lib/youtube';
// Association ("Membership Matters") and sponsor cards are edited through
// Pages CMS in src/data/{associations,sponsors}.json — list order there is
// display order here. Logos resolve back to optimized assets in landing-data.
import { sponsors, associations } from '../lib/landing-data';

const YOUTUBE_CHANNEL = 'https://www.youtube.com/@BehindTheSigns';
const SHOP_TOURS_PLAYLIST = 'https://www.youtube.com/playlist?list=PLWFiBORpfpiB1tOaQVYl2_9JO0PXCT3xg';
const FACEBOOK_GROUP = 'https://www.facebook.com/groups/behindthesigns';

const videos = await fetchLatestVideos(3);

// Real articles start landing in 2026 (one long-form piece a month). The two
// 2024-dated files in src/content/blog are dev samples — the date gate keeps
// them off the landing page and admits real posts as they're published.
const ARTICLES_LIVE_FROM = new Date('2026-01-01');
const articles = (await getPublishedPosts())
  .filter((post) => post.data.pubDate >= ARTICLES_LIVE_FROM)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const sourceMeta = {
  interviews: { label: 'Guest Interview', badge: 'badge badge-pink' },
  topics: { label: 'Topics & Trends', badge: 'badge badge-gold' },
  'shop-tours': { label: 'Shop Tour', badge: 'badge badge-teal' },
} as const;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

// Top-nav section links — order and wording from Joe's site plan. Subscribe
// rides along as the nav's CTA button rather than a list item.
const navLinks = [
  { href: '#podcast', label: 'Podcast' },
  { href: '#shop-tours', label: 'Shop Tours' },
  { href: '#blog', label: 'Blog' },
  { href: '#about', label: 'About' },
  { href: '#associations', label: 'Associations' },
  { href: '#sponsors', label: 'Sponsors' },
];

const icons: Record<string, string> = {
  mic: '<rect x="9" y="2.5" width="6" height="11" rx="3"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0"/><path d="M12 18v3.5"/><path d="M8.5 21.5h7"/>',
  store:
    '<path d="M4.5 9.5 6 4h12l1.5 5.5"/><path d="M3.5 9.5h17"/><path d="M5.5 9.5V20h13V9.5"/><path d="M9.5 20v-5.5h5V20"/>',
  chat: '<path d="M19.5 4h-15A2.5 2.5 0 0 0 2 6.5v8A2.5 2.5 0 0 0 4.5 17H7v4l5-4h7.5a2.5 2.5 0 0 0 2.5-2.5v-8A2.5 2.5 0 0 0 19.5 4Z"/><circle cx="7.5" cy="10.5" r="1.15" fill="currentColor" stroke="none"/><circle cx="12" cy="10.5" r="1.15" fill="currentColor" stroke="none"/><circle cx="16.5" cy="10.5" r="1.15" fill="currentColor" stroke="none"/>',
};

// Footer social row — Joe's channel list, in his order.
const socialLinks = [
  {
    href: FACEBOOK_GROUP,
    label: 'Facebook community',
    icon: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
  },
  {
    href: 'https://www.instagram.com/behindthesignspodcast/',
    label: 'Instagram',
    icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1 1 12.324 0 6.162 6.162 0 0 1-12.324 0zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm4.965-10.405a1.44 1.44 0 1 1 2.881.001 1.44 1.44 0 0 1-2.881-.001z',
  },
  {
    href: YOUTUBE_CHANNEL,
    label: 'YouTube',
    icon: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
  },
  {
    href: 'https://www.tiktok.com/@behind_the_signs',
    label: 'TikTok',
    icon: 'M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z',
  },
  {
    href: 'https://podcasts.apple.com/us/podcast/behind-the-signs-podcast/id1813842104',
    label: 'Apple Podcasts',
    icon: 'M5.34 0A5.328 5.328 0 0 0 0 5.34v13.32A5.328 5.328 0 0 0 5.34 24h13.32A5.328 5.328 0 0 0 24 18.66V5.34A5.328 5.328 0 0 0 18.66 0zm6.525 2.568c2.336 0 4.448.902 6.056 2.587 1.224 1.272 1.912 2.619 2.264 4.392.12.59.12 2.2.007 2.864a8.506 8.506 0 0 1-3.24 5.296c-.608.46-2.096 1.261-2.336 1.261-.088 0-.096-.091-.056-.46.072-.592.144-.715.48-.856.536-.224 1.448-.874 2.008-1.435a8.046 8.046 0 0 0 2.104-3.544c.208-.744.365-2.32.288-3.264-.24-2.928-2.087-5.535-4.792-6.744-.784-.352-1.344-.512-2.28-.633-2.944-.376-5.795.936-7.483 3.433a7.947 7.947 0 0 0-1.4 6.072c.415 2.352 1.943 4.464 4.031 5.568.408.216.888.44 1.064.496.336.144.408.264.472.856.04.36.03.464-.056.464-.056 0-.464-.176-.896-.384l-.04-.03c-2.472-1.216-4.056-3.274-4.632-6.012-.144-.706-.168-2.392-.03-3.04.36-1.74 1.048-3.1 2.192-4.304 1.649-1.744 3.768-2.664 6.128-2.664zm.134 2.81c.409.004.803.04 1.106.106 2.784.62 4.76 3.408 4.376 6.174-.152 1.114-.536 2.03-1.216 2.88-.336.43-1.152 1.15-1.296 1.15-.023 0-.048-.272-.048-.603v-.605l.416-.496c1.568-1.878 1.456-4.502-.256-6.224-.664-.67-1.432-1.064-2.424-1.246-.64-.118-.776-.118-1.448-.008-1.02.167-1.81.562-2.512 1.256-1.72 1.704-1.834 4.34-.266 6.222l.413.496v.608c0 .336-.027.608-.06.608-.03 0-.264-.16-.512-.36l-.034-.011c-.832-.664-1.568-1.842-1.872-2.997-.184-.698-.184-2.024.008-2.72.504-1.878 1.888-3.335 3.808-4.019.41-.145 1.133-.22 1.817-.211zm-.13 2.99c.31.003.598.06.815.172.465.24.84.61 1.064 1.048.586 1.15.077 2.542-1.088 2.997a1.907 1.907 0 0 1-1.32 0c-1.165-.455-1.674-1.847-1.088-2.997.383-.75 1.037-1.164 1.617-1.22zm-.007 4.943c.72-.005 1.246.25 1.4.686.132.36.084.75-.144 2.312-.156 1.129-.244 1.766-.318 2.06-.12.48-.462.844-.878.935a1.851 1.851 0 0 1-.766-.043c-.415-.09-.757-.455-.877-.934-.074-.295-.162-.932-.318-2.061-.228-1.561-.276-1.952-.144-2.312.15-.427.66-.68 1.36-.686z',
  },
  {
    href: 'https://open.spotify.com/show/53qvCb4Pqj6f5TP35RzJ8A',
    label: 'Spotify',
    icon: 'M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z',
  },
];

const description =
  'Behind the Signs brings the sign industry together. Real conversations with the people shaping the industry, behind-the-scenes Shop Tours, and a community of thousands of sign professionals.';

// Structured data: who we are + the site itself. Kept in @graph so the
// WebSite node can reference the Organization as its publisher.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://behindthesigns.com/#organization',
      name: 'Behind the Signs',
      url: 'https://behindthesigns.com/',
      logo: { '@type': 'ImageObject', url: 'https://behindthesigns.com/logo.png', width: 512, height: 512 },
      description,
      founder: [
        { '@type': 'Person', name: 'Joe Arenella', jobTitle: 'Host & Founder' },
        { '@type': 'Person', name: 'Elizabeth Arenella Toynes', jobTitle: 'Host' },
      ],
      sameAs: [
        'https://www.youtube.com/@BehindTheSigns',
        'https://www.facebook.com/profile.php?id=61561938735595',
        'https://www.facebook.com/groups/behindthesigns/',
        'https://www.instagram.com/behindthesignspodcast/',
        'https://www.tiktok.com/@behind_the_signs',
        'https://podcasts.apple.com/us/podcast/behind-the-signs-podcast/id1813842104',
        'https://open.spotify.com/show/53qvCb4Pqj6f5TP35RzJ8A',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://behindthesigns.com/#website',
      url: 'https://behindthesigns.com/',
      name: 'Behind the Signs',
      description,
      publisher: { '@id': 'https://behindthesigns.com/#organization' },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>Behind the Signs | Elevating the Sign Industry Together</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Behind the Signs"
      href={new URL('/rss.xml', Astro.site)}
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL('/', Astro.site)} />
    <meta property="og:title" content="Behind the Signs | Elevating the Sign Industry Together" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og-image.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Behind the Signs wordmark over a sign-shop photo" />
    <meta property="og:site_name" content="Behind the Signs" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Behind the Signs | Elevating the Sign Industry Together" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.jpg', Astro.site)} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <Analytics />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Permanent+Marker&family=Roboto:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body id="top" class="bg-surf-600 min-h-screen font-body">
    <!-- ============ TOP NAV — sticky ink bar per Joe's mockup ============ -->
    <header class="site-nav">
      <div class="container-custom flex h-16 items-center justify-between gap-6">
        <a
          href="#top"
          id="nav-brand"
          class="flex items-center shrink-0 opacity-0 pointer-events-none transition-opacity duration-300 motion-reduce:transition-none"
          aria-label="Behind the Signs, back to top"
        >
          <img src={wordmarkInk.src} alt="" class="h-10 w-auto" />
        </a>
        <noscript>
          <style>
            #nav-brand { opacity: 1; pointer-events: auto; }
          </style>
        </noscript>

        <nav aria-label="Sections" class="hidden lg:flex items-center gap-2">
          {navLinks.map((l) => <a href={l.href} class="nav-link">{l.label}</a>)}
          <a href="#subscribe" class="btn-primary btn-sm ml-3">Subscribe</a>
        </nav>

        <button
          type="button"
          id="nav-toggle"
          class="lg:hidden grid h-10 w-10 place-items-center text-ink/80 hover:text-ink"
          aria-expanded="false"
          aria-controls="nav-menu"
          aria-label="Open menu"
        >
          <svg data-icon-open viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="h-6 w-6">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg data-icon-close viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="hidden h-6 w-6">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>

      <nav id="nav-menu" aria-label="Sections" class="hidden lg:hidden border-t border-slate-200 bg-white">
        <ul class="container-custom py-4 grid gap-1">
          {
            navLinks.map((l) => (
              <li>
                <a href={l.href} class="nav-link block py-2.5">{l.label}</a>
              </li>
            ))
          }
          <li class="pt-3">
            <a href="#subscribe" class="btn-primary btn-sm btn-block">Subscribe</a>
          </li>
        </ul>
      </nav>
    </header>

    <main>
      <!-- ============ HERO — sticker-print photo, wordmark, tagline ============ -->
      <section class="hero">
        <div class="absolute inset-0 anim-zoom-settle">
          <Image
            src={heroBg}
            alt=""
            class="hero-media"
            loading="eager"
            widths={[768, 1280, 1920, 2560]}
            sizes="100vw"
          />
        </div>
        <div class="absolute inset-0 bg-surf-600/50"></div>
        <div class="hero-fade"></div>

        <div class="relative flex flex-col items-center text-center px-6 pt-16 pb-16 sm:pt-20 sm:pb-20 lg:pt-24 lg:pb-24">
          <img
            id="hero-wordmark"
            src={wordmark.src}
            alt="Behind the Signs"
            class="anim-drop-in w-[80vw] max-w-[300px] sm:max-w-[430px] lg:max-w-[540px] h-auto drop-shadow-[0_8px_18px_rgba(0,40,55,0.35)]"
          />
          <h1 class="headline headline-light tracking-normal text-xl sm:text-2xl lg:text-3xl mt-8 sm:mt-10 anim-rise-in anim-delay-2">
            <span class="sr-only">Behind the Signs: </span>Elevating the sign industry together.
          </h1>
          <div class="mt-9 sm:mt-10 flex flex-wrap items-center justify-center gap-4 anim-rise-in anim-delay-3">
            <a href={FACEBOOK_GROUP} target="_blank" rel="noopener noreferrer" class="btn-white">
              Join Community
            </a>
            <a href="#subscribe" class="btn-gold">Get the Newsletter</a>
          </div>
        </div>
      </section>

      <!-- ============ LATEST VIDEOS — refreshed from YouTube on every deploy ============ -->
      <section class="section section-white" aria-labelledby="latest-heading">
        <div class="container-custom">
          <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-5 mb-10 sm:mb-12">
            <div>
              <span class="eyebrow">just uploaded</span>
              <h2 id="latest-heading" class="headline text-3xl sm:text-4xl lg:text-5xl mt-2">The Latest</h2>
            </div>
            <a href={YOUTUBE_CHANNEL} target="_blank" rel="noopener noreferrer" class="btn-secondary">
              View the channel
            </a>
          </div>

          <ul class="grid gap-8 md:grid-cols-3">
            {
              videos.map((v) => (
                <li>
                  <article class="panel panel-hover overflow-hidden h-full flex flex-col">
                    <a
                      href={`https://www.youtube.com/watch?v=${v.id}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group relative block aspect-video overflow-hidden bg-surf-950"
                      data-video-embed
                      data-video-id={v.id}
                      data-video-title={v.title}
                      aria-label={`Play video: ${v.title}`}
                    >
                      <img
                        src={`https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`}
                        onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${v.id}/hqdefault.jpg';`}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="absolute inset-0 h-full w-full object-cover"
                      />
                      <span class="absolute inset-0 bg-surf-950/0 transition-colors duration-200 group-hover:bg-surf-950/15"></span>
                      <span class="absolute inset-0 grid place-items-center">
                        <span class="grid h-14 w-14 sm:h-16 sm:w-16 place-items-center rounded-full bg-pink-500 text-white shadow-md transition-colors duration-200 group-hover:bg-pink-600">
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-6 w-6 translate-x-0.5">
                            <path d="M8 5.5v13l11-6.5z" />
                          </svg>
                        </span>
                      </span>
                    </a>
                    <div class="p-5 sm:p-6 flex flex-col gap-3 grow">
                      <div class="flex items-center gap-2.5">
                        <span class={sourceMeta[v.source].badge}>{sourceMeta[v.source].label}</span>
                        <time class="text-sm font-medium text-slate-500" datetime={v.published.toISOString()}>
                          {fmt(v.published)}
                        </time>
                      </div>
                      <h3 class="font-black text-lg leading-snug">
                        <a
                          href={`https://www.youtube.com/watch?v=${v.id}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="transition-colors hover:text-pink-600"
                        >
                          {v.title}
                        </a>
                      </h3>
                    </div>
                  </article>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ============ PODCAST · SHOP TOURS · COMMUNITY ============ -->
      <section class="section section-tint">
        <h2 class="sr-only">Watch and join</h2>
        <div class="container-custom grid gap-8 lg:gap-10">
          <div class="grid gap-8 md:grid-cols-2 lg:gap-10">
            <a
              id="podcast"
              href={YOUTUBE_CHANNEL}
              target="_blank"
              rel="noopener noreferrer"
              class="dest block scroll-mt-24 focus-visible:outline-none"
              aria-label="Watch the Behind the Signs Podcast on YouTube"
            >
              <div class="panel-cabinet h-full flex">
                <div class="panel-cabinet-face w-full flex flex-col items-center text-center gap-3.5 px-6 py-9 sm:px-8">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-9 w-9 text-white/95" set:html={icons.mic} />
                  <h3 class="headline headline-light text-2xl sm:text-3xl">The Podcast</h3>
                  <p class="text-white/90 text-lg sm:text-xl leading-relaxed max-w-md">
                    Real conversations with the people shaping the industry.
                  </p>
                  <span class="btn-white btn-sm mt-1.5" aria-hidden="true">Watch Podcasts</span>
                </div>
              </div>
