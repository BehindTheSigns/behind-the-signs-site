---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

// Get all blog posts, sorted by date
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Category counts for filter
const categories = ['business-tips', 'technical-guides', 'industry-news', 'case-studies'];
---

<BaseLayout title="Blog" description="Industry insights, technical guides, and business strategies for sign professionals">
  <!-- Page Header -->
  <section class="hero-bg bokeh-bg py-20 lg:py-24">
    <div class="container-custom relative-content text-center">
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-4 font-['Bebas_Neue']">
        The Behind the Signs <span class="text-pink-400">Blog</span>
      </h1>
      <p class="text-xl text-white/80 max-w-3xl mx-auto">
        Practical insights, technical guides, and business strategies from 30+ years in the sign industry
      </p>
    </div>
  </section>

  <!-- Categories Filter -->
  <section class="py-6 bg-white border-b border-slate-100 sticky top-16 lg:top-20 z-40">
    <div class="container-custom">
      <div class="flex flex-wrap gap-2 justify-center">
        <button
          data-category="all"
          class="category-filter px-5 py-2 rounded-full font-semibold text-sm transition-all bg-pink-500 text-white"
        >
          All Posts
        </button>
        {categories.map((category) => (
          <button
            data-category={category}
            class="category-filter px-5 py-2 rounded-full font-semibold text-sm transition-all bg-slate-100 text-slate-600 hover:bg-slate-200"
          >
            {category.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ')}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Blog Posts Grid -->
  <section class="py-16 lg:py-20 bg-slate-50">
    <div class="container-custom">
      {sortedPosts.length === 0 ? (
        <div class="text-center py-12">
          <div class="max-w-md mx-auto">
            <svg class="w-24 h-24 mx-auto text-slate-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
            <h2 class="text-2xl font-bold text-slate-800 mb-2">No blog posts yet</h2>
            <p class="text-slate-600 mb-6">
              We're working on creating valuable content for you. Check back soon!
            </p>
            <a href="/" class="btn-primary">
              Return Home
            </a>
          </div>
        </div>
      ) : (
        <>
          <div id="blog-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {sortedPosts.map((post) => (
              <div data-category={post.data.category} class="blog-post">
                <BlogCard
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  category={post.data.category}
                  slug={post.slug}
                  image={post.data.heroImage}
                  tags={post.data.tags}
                />
              </div>
            ))}
          </div>

          <!-- Load More Button (for future pagination) -->
          <div class="text-center mt-12">
            <button class="btn-highlight" id="load-more" style="display: none;">
              Load More Posts
            </button>
          </div>
        </>
      )}
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="py-16 lg:py-20 relative overflow-hidden">
    <div class="absolute inset-0 sign-board"></div>
    <div class="absolute inset-0 bg-gradient-to-br from-pink-600/90 to-pink-500/90"></div>

    <div class="container-custom relative text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4 font-['Bebas_Neue']">
        Never Miss a Post
      </h2>
      <p class="text-white/90 text-lg mb-8 max-w-2xl mx-auto">
        Subscribe to our newsletter and get the latest insights delivered to your inbox every week.
      </p>
      <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
        <input
          type="email"
          placeholder="Enter your email"
          required
          class="flex-1 px-6 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-white/50 focus:border-transparent"
        />
        <button type="submit" class="btn-highlight">
          Subscribe
        </button>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  // Category filtering
  const categoryButtons = document.querySelectorAll('.category-filter');
  const blogPosts = document.querySelectorAll('.blog-post');

  categoryButtons.forEach(button => {
    button.addEventListener('click', () => {
      const category = button.dataset.category;

      // Update button styles
      categoryButtons.forEach(btn => {
        btn.classList.remove('bg-pink-500', 'text-white');
        btn.classList.add('bg-slate-100', 'text-slate-600');
      });
      button.classList.remove('bg-slate-100', 'text-slate-600');
      button.classList.add('bg-pink-500', 'text-white');

      // Filter posts
      blogPosts.forEach(post => {
        if (category === 'all' || post.dataset.category === category) {
          post.style.display = 'block';
        } else {
          post.style.display = 'none';
        }
      });
    });
  });
</script>