---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PodcastCard from '../../components/PodcastCard.astro';

export async function getStaticPaths() {
  const episodes = await getCollection('podcasts');
  return episodes.map((episode) => ({
    params: { episode: episode.data.episode.toString() },
    props: { episode },
  }));
}

const { episode } = Astro.props;

// Get other episodes for recommendations
const allEpisodes = await getCollection('podcasts');
const otherEpisodes = allEpisodes
  .filter(e => e.data.episode !== episode.data.episode)
  .sort((a, b) => b.data.episode - a.data.episode)
  .slice(0, 3);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(episode.data.pubDate);
---

<BaseLayout 
  title={`Episode ${episode.data.episode}: ${episode.data.title}`} 
  description={episode.data.description}
  image={`https://img.youtube.com/vi/${episode.data.youtubeId}/maxresdefault.jpg`}
>
  <article>
    <!-- Episode Header -->
    <section class="bg-gradient-to-br from-teal-500 via-teal-600 to-teal-700 py-20">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto text-center">
          <div class="flex items-center justify-center gap-4 mb-6">
            <span class="bg-yellow-400 text-gray-900 px-4 py-2 rounded-full text-sm font-bold">
              EPISODE {episode.data.episode}
            </span>
            <time class="text-white/80">{formattedDate}</time>
            <span class="text-white/80">{episode.data.duration}</span>
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 font-['Bebas_Neue'] leading-tight">
            {episode.data.title}
          </h1>
          
          {episode.data.guest && (
            <p class="text-xl text-yellow-400 mb-4">
              Featuring: {episode.data.guest}
            </p>
          )}
          
          <p class="text-xl text-white/90">
            {episode.data.description}
          </p>
        </div>
      </div>
    </section>
    
    <!-- Video Player -->
    <section class="py-12 bg-white">
      <div class="container-custom">
        <div class="max-w-5xl mx-auto">
          <div class="aspect-video bg-gray-900 rounded-2xl overflow-hidden shadow-2xl">
            <iframe 
              width="100%" 
              height="100%" 
              src={`https://www.youtube.com/embed/${episode.data.youtubeId}`}
              title={episode.data.title}
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
              allowfullscreen
            ></iframe>
          </div>
          
          <!-- Episode Actions -->
          <div class="mt-8 flex flex-wrap gap-4 justify-center">
            <a 
              href={`https://www.youtube.com/watch?v=${episode.data.youtubeId}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              Watch on YouTube
            </a>
            
            <button 
              onclick={`navigator.share && navigator.share({title: '${episode.data.title}', url: window.location.href})`}
              class="btn-secondary"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m9.032 4.026a9.001 9.001 0 01-7.432 0m9.032-4.026A9.001 9.001 0 0112 3c-4.474 0-8.268 3.12-9.032 7.326m0 0A9.001 9.001 0 0012 21c4.474 0 8.268-3.12 9.032-7.326"></path>
              </svg>
              Share Episode
            </button>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Episode Details -->
    <section class="py-12 bg-gray-50">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto">
          <!-- Topics -->
          {episode.data.topics && episode.data.topics.length > 0 && (
            <div class="mb-8">
              <h2 class="text-2xl font-bold text-gray-900 mb-4 font-['Bebas_Neue']">Topics Discussed</h2>
              <div class="flex flex-wrap gap-2">
                {episode.data.topics.map((topic: string) => (
                  <span class="px-4 py-2 bg-teal-100 text-teal-800 rounded-full text-sm font-semibold">
                    {topic}
                  </span>
                ))}
              </div>
            </div>
          )}
          
          <!-- Key Takeaways -->
          {episode.data.keyTakeaways && episode.data.keyTakeaways.length > 0 && (
            <div class="mb-8">
              <h2 class="text-2xl font-bold text-gray-900 mb-4 font-['Bebas_Neue']">Key Takeaways</h2>
              <div class="bg-white rounded-xl p-6 shadow-md">
                <ul class="space-y-3">
                  {episode.data.keyTakeaways.map((takeaway: string) => (
                    <li class="flex items-start">
                      <svg class="w-6 h-6 text-pink-500 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                      </svg>
                      <span class="text-gray-700">{takeaway}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )}
          
          <!-- Subscribe CTA -->
          <div class="bg-gradient-to-r from-pink-500 to-pink-600 rounded-2xl p-8 text-white text-center">
            <h3 class="text-2xl font-bold mb-4 font-['Bebas_Neue']">Enjoyed this episode?</h3>
            <p class="mb-6">Subscribe to never miss future conversations with sign industry leaders.</p>
            <div class="flex flex-col sm:flex-row gap-3 justify-center">
              <a href="https://www.youtube.com/@BehindTheSigns" target="_blank" rel="noopener noreferrer" 
                 class="btn-secondary">
                Subscribe on YouTube
              </a>
              <button class="px-6 py-3 bg-white/20 backdrop-blur-sm text-white font-bold rounded-lg hover:bg-white/30 transition-colors">
                Get Email Alerts
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- More Episodes -->
    {otherEpisodes.length > 0 && (
      <section class="py-16 bg-white">
        <div class="container-custom">
          <h2 class="text-3xl font-bold text-center mb-12 font-['Bebas_Neue']">
            More <span class="text-gradient">Episodes</span>
          </h2>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
            {otherEpisodes.map((ep) => (
              <PodcastCard 
                title={ep.data.title}
                description={ep.data.description}
                episode={ep.data.episode}
                pubDate={ep.data.pubDate}
                youtubeId={ep.data.youtubeId}
                duration={ep.data.duration}
                guest={ep.data.guest}
              />
            ))}
          </div>
          
          <div class="text-center mt-12">
            <a href="/podcast" class="btn-primary">
              View All Episodes
            </a>
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>