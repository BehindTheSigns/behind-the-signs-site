---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Newsletter Preview - Behind the Signs"
  description="See what our weekly newsletter looks like. Industry insights, tips, and news delivered to your inbox."
>
  <!-- Hero Section -->
  <section class="hero-bg bokeh-bg py-16 lg:py-20">
    <div class="container-custom relative-content">
      <div class="max-w-3xl mx-auto text-center">
        <span class="text-pink-400 font-bold text-sm uppercase tracking-wider">Newsletter Preview</span>
        <h1 class="text-4xl md:text-5xl text-white mt-2 mb-4">
          See What You'll <span class="text-gradient">Receive</span>
        </h1>
        <p class="text-xl text-slate-300">
          Every week, we deliver actionable insights, industry news, and expert tips straight to your inbox. Here's a sample of what our newsletter looks like.
        </p>
      </div>
    </div>
  </section>

  <!-- Newsletter Preview -->
  <section class="py-12 lg:py-16 bg-slate-100">
    <div class="container-custom">
      <!-- Info Bar -->
      <div class="max-w-3xl mx-auto mb-8">
        <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <h2 class="text-lg font-bold text-slate-900">Weekly Newsletter Sample</h2>
              <p class="text-slate-600 text-sm">This is an example of our weekly email newsletter</p>
            </div>
            <a href="/newsletter-example.html" target="_blank" class="btn-secondary text-sm">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
              Open in New Tab
            </a>
          </div>
        </div>
      </div>

      <!-- Newsletter Frame -->
      <div class="max-w-3xl mx-auto">
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-slate-200">
          <!-- Browser Chrome -->
          <div class="bg-slate-800 px-4 py-3 flex items-center gap-2">
            <div class="flex gap-1.5">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
            </div>
            <div class="flex-1 ml-4">
              <div class="bg-slate-700 rounded-md px-3 py-1.5 text-slate-400 text-xs font-mono truncate">
                inbox — Behind the Signs Newsletter
              </div>
            </div>
          </div>

          <!-- Newsletter Content -->
          <div class="relative" style="height: 800px;">
            <iframe
              src="/newsletter-example.html"
              class="absolute inset-0 w-full h-full border-0"
              title="Newsletter Preview"
            ></iframe>
          </div>
        </div>
      </div>

      <!-- Features List -->
      <div class="max-w-3xl mx-auto mt-12">
        <h3 class="text-2xl font-bold text-slate-900 text-center mb-8">What's Inside Every Issue</h3>
        <div class="grid sm:grid-cols-2 gap-6">
          <div class="flex items-start gap-4">
            <div class="feature-icon feature-icon-yellow">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 mb-1">Featured Articles</h4>
              <p class="text-slate-600 text-sm">Deep dives into pricing, sales, operations, and growth strategies</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="feature-icon feature-icon-pink">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 mb-1">Latest Episodes</h4>
              <p class="text-slate-600 text-sm">Links to new podcast episodes with key takeaways</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="feature-icon feature-icon-cyan">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 mb-1">Quick Tips</h4>
              <p class="text-slate-600 text-sm">Actionable advice you can implement immediately</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="feature-icon feature-icon-yellow">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
              </svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 mb-1">Industry News</h4>
              <p class="text-slate-600 text-sm">Curated updates on materials, equipment, and events</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 lg:py-20 bg-pink-500">
    <div class="container-custom">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl text-white mb-4">
          Want This in Your Inbox?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Join thousands of sign professionals getting weekly insights delivered every Tuesday.
        </p>
        <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
          <input
            type="email"
            placeholder="Enter your email"
            required
            class="flex-1 px-6 py-3 rounded-lg bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-pink-500"
          />
          <button type="submit" class="px-6 py-3 bg-slate-900 text-white font-bold rounded-lg hover:bg-slate-800 transition-colors">
            Subscribe Free
          </button>
        </form>
        <p class="text-white/70 text-sm mt-4">
          No spam, unsubscribe anytime. We respect your privacy.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
