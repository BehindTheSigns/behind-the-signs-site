const footerLinks = {
  'Content': [
    { href: '/blog', label: 'Blog' },
    { href: '/podcast', label: 'Podcast Episodes' },
    { href: '/resources', label: 'Resources' },
  ],
  'Company': [
    { href: '/about', label: 'About Us' },
    { href: '/community', label: 'Community' },
    { href: '/contact', label: 'Contact' },
  ],
  'Legal': [
    { href: '/privacy', label: 'Privacy Policy' },
    { href: '/terms', label: 'Terms of Service' },
    { href: '/cookies', label: 'Cookie Policy' },
  ],
};
---

<footer class="bg-slate-900 text-white">
  <div class="container-custom py-12 lg:py-16">
    <!-- Newsletter Section -->
    <div id="newsletter" class="relative rounded-2xl p-8 lg:p-10 mb-12 overflow-hidden">
      <!-- Background gradient -->
      <div class="absolute inset-0 bg-gradient-to-r from-pink-500 via-pink-500 to-pink-500"></div>
      <!-- Subtle pattern overlay -->
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px;"></div>

      <div class="relative max-w-2xl mx-auto text-center">
        <h3 class="text-2xl sm:text-3xl lg:text-4xl text-white mb-4 tracking-wide">
          Join the Sign Revolution
        </h3>
        <p class="text-white/90 mb-6 text-sm sm:text-base">
          Get weekly insights, industry tips, and exclusive content delivered straight to your inbox.
        </p>
        <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
          <input
            type="email"
            placeholder="Enter your email"
            required
            class="flex-1 px-5 py-3 rounded-lg bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-white"
          />
          <button type="submit" class="px-6 py-3 bg-slate-900 text-white font-bold rounded-lg hover:bg-slate-800 transition-colors">
            Subscribe
          </button>
        </form>
      </div>
    </div>

    <!-- Footer Links Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
      <!-- Logo and Description -->
      <div class="col-span-2 md:col-span-1">
        <div class="mb-4">
          <Image
            src={logo}
            alt="Behind the Signs"
            class="h-16 w-auto"
          />
        </div>
        <p class="text-slate-400 text-sm leading-relaxed">
          Elevating the sign industry through conversations, insights, and 30+ years of expertise.
        </p>
      </div>

      <!-- Footer Link Columns -->
      {Object.entries(footerLinks).map(([category, links]) => (
        <div>
          <h4 class="font-semibold text-white mb-4 text-sm uppercase tracking-wider">{category}</h4>
          <ul class="space-y-2.5">
            {links.map((link) => (
              <li>
                <a href={link.href} class="text-slate-400 hover:text-pink-400 transition-colors text-sm">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Social Links and Copyright -->
    <div class="border-t border-slate-800 pt-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <!-- Social Links -->
        <div class="flex items-center space-x-3">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-800 hover:bg-pink-500 transition-all duration-200 group hover:scale-110"
              aria-label={social.label}
            >
              <svg class="w-5 h-5 fill-current text-slate-400 group-hover:text-white transition-colors" viewBox="0 0 24 24">
                <path d={social.icon} />
              </svg>
            </a>
          ))}
        </div>

        <!-- Copyright -->
        <p class="text-slate-500 text-sm text-center md:text-left">
          © {currentYear} Behind the Signs. All rights reserved.
        </p>
      </div>
    </div>
  </div>
</footer>
