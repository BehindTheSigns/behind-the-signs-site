---
import { Image } from 'astro:assets';
import bgImage from '../assets/BTS_background.jpg';
import logo from '../assets/BTS_Sign.png';

export interface Props {
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  subtitle = "Elevating the sign industry together.",
  ctaText = "Start Listening",
  ctaLink = "/podcast"
} = Astro.props;
---

<section class="relative min-h-[500px] lg:min-h-[600px] flex items-center overflow-hidden">
  <!-- Background Image -->
  <Image
    src={bgImage}
    alt=""
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
  />

  <!-- Subtle dark overlay for better contrast -->
  <div class="absolute inset-0 bg-gradient-to-r from-black/30 via-black/20 to-black/30"></div>

  <!-- Content -->
  <div class="container-custom relative z-10 py-16 lg:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12 items-center">
      <!-- Logo - Left 2/5 -->
      <div class="lg:col-span-2 flex justify-center lg:justify-start">
        <Image
          src={logo}
          alt="Behind the Signs"
          class="w-full max-w-sm md:max-w-md lg:max-w-full h-auto drop-shadow-2xl"
          loading="eager"
        />
      </div>

      <!-- Text & Buttons - Right 3/5 -->
      <div class="lg:col-span-3 text-center lg:text-left">
        <!-- Tagline -->
        <h1 class="text-white text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-black tracking-tight drop-shadow-lg mb-6">
          {subtitle}
        </h1>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-10">
          <a href={ctaLink} class="btn-primary text-lg group">
            <svg class="w-5 h-5 mr-2 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/>
            </svg>
            {ctaText}
          </a>
          <a href="/blog" class="btn-white text-lg">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
            Read the Blog
          </a>
        </div>

        <!-- Stats row -->
        <div class="flex flex-wrap justify-center lg:justify-start gap-8 lg:gap-12">
          <div class="text-center lg:text-left">
            <div class="text-2xl sm:text-3xl font-black text-white drop-shadow-lg">100+</div>
            <div class="text-sm text-white/80 uppercase tracking-wider">Episodes</div>
          </div>
          <div class="text-center lg:text-left">
            <div class="text-2xl sm:text-3xl font-black text-white drop-shadow-lg">50K+</div>
            <div class="text-sm text-white/80 uppercase tracking-wider">Followers</div>
          </div>
          <div class="text-center lg:text-left">
            <div class="text-2xl sm:text-3xl font-black text-white drop-shadow-lg">30+</div>
            <div class="text-sm text-white/80 uppercase tracking-wider">Years Exp.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
