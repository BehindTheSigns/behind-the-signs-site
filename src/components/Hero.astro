---
export interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
}

const { 
  title = "Welcome to Behind the Signs", 
  subtitle = "Elevating the sign industry through conversations with professionals, sharing ideas, growth tips, and trade hacks.",
  ctaText = "Start Listening",
  ctaLink = "/podcast"
} = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-teal-500 via-teal-600 to-teal-700">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%23ffffff" fill-opacity="0.4"%3E%3Cpath d="M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E'); background-size: 60px 60px;"></div>
  </div>
  
  <div class="container-custom relative">
    <div class="py-24 md:py-32 lg:py-40">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Content -->
        <div class="text-center lg:text-left">
          <div class="inline-block mb-4">
            <span class="inline-flex items-center px-4 py-2 bg-yellow-400 text-gray-900 text-sm font-bold rounded-full">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              30+ Years of Industry Expertise
            </span>
          </div>
          
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6 font-['Bebas_Neue'] leading-tight">
            <span class="block">BEHIND</span>
            <span class="block text-yellow-400 neon-text">THE SIGNS</span>
          </h1>
          
          <p class="text-xl md:text-2xl text-white/90 mb-8 leading-relaxed">
            {subtitle}
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a href={ctaLink} class="btn-primary text-lg">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
              </svg>
              {ctaText}
            </a>
            <a href="/blog" class="btn-secondary text-lg">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
              Read the Blog
            </a>
          </div>
          
          <!-- Stats -->
          <div class="mt-12 grid grid-cols-3 gap-4">
            <div class="text-center lg:text-left">
              <div class="text-3xl font-bold text-yellow-400">100+</div>
              <div class="text-sm text-white/80">Episodes</div>
            </div>
            <div class="text-center lg:text-left">
              <div class="text-3xl font-bold text-yellow-400">50K+</div>
              <div class="text-sm text-white/80">Followers</div>
            </div>
            <div class="text-center lg:text-left">
              <div class="text-3xl font-bold text-yellow-400">30+</div>
              <div class="text-sm text-white/80">Years Experience</div>
            </div>
          </div>
        </div>
        
        <!-- Visual Element -->
        <div class="relative hidden lg:block">
          <div class="relative">
            <!-- Animated Sign Board -->
            <div class="bg-gray-900 rounded-2xl p-8 shadow-2xl transform rotate-3 hover:rotate-1 transition-transform duration-300">
              <div class="border-4 border-pink-500 rounded-xl p-6 neon-border">
                <div class="text-center">
                  <div class="text-6xl font-bold text-yellow-400 font-['Bebas_Neue'] mb-2 animate-pulse-slow">
                    ON AIR
                  </div>
                  <div class="text-pink-500 text-2xl font-bold tracking-wider neon-text">
                    PODCAST
                  </div>
                  <div class="mt-4 flex justify-center space-x-2">
                    <div class="w-3 h-3 bg-pink-500 rounded-full animate-pulse"></div>
                    <div class="w-3 h-3 bg-yellow-400 rounded-full animate-pulse" style="animation-delay: 0.2s"></div>
                    <div class="w-3 h-3 bg-teal-400 rounded-full animate-pulse" style="animation-delay: 0.4s"></div>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Floating Elements -->
            <div class="absolute -top-4 -right-4 bg-yellow-400 text-gray-900 px-4 py-2 rounded-full font-bold animate-float">
              NEW EPISODE
            </div>
            <div class="absolute -bottom-4 -left-4 bg-pink-500 text-white px-4 py-2 rounded-full font-bold animate-float" style="animation-delay: 1.5s">
              SUBSCRIBE
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>