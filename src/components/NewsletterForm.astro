---
export interface Props {
  variant?: 'inline' | 'popup';
  buttonText?: string;
  placeholder?: string;
}

const { 
  variant = 'inline', 
  buttonText = 'Subscribe',
  placeholder = 'Enter your email'
} = Astro.props;

const formId = `newsletter-form-${Math.random().toString(36).substr(2, 9)}`;
---

<form id={formId} class="newsletter-form" data-variant={variant}>
  <div class={variant === 'inline' ? 'flex flex-col sm:flex-row gap-3' : 'space-y-3'}>
    <input 
      type="email" 
      name="email"
      placeholder={placeholder}
      required
      class="flex-1 px-4 py-3 rounded-lg text-gray-900 placeholder-gray-500 bg-white focus:outline-none focus:ring-4 focus:ring-pink-500/30"
    />
    <button 
      type="submit" 
      class={variant === 'inline' ? 'btn-primary' : 'w-full btn-primary'}
    >
      {buttonText}
    </button>
  </div>
  <div class="form-message hidden mt-3 p-3 rounded-lg text-sm font-semibold"></div>
</form>

<script define:vars={{ formId }}>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById(formId);
    if (!form) return;

    const messageDiv = form.querySelector('.form-message');
    
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const email = formData.get('email');
      const button = form.querySelector('button[type="submit"]');
      const originalButtonText = button.textContent;
      
      // Show loading state
      button.disabled = true;
      button.textContent = 'Subscribing...';
      messageDiv.classList.add('hidden');
      
      try {
        // Mock API call - replace with actual Mailchimp integration
        await new Promise(resolve => setTimeout(resolve, 1500));
        
        // For now, just store in localStorage as a mock
        const subscribers = JSON.parse(localStorage.getItem('mockSubscribers') || '[]');
        
        if (subscribers.includes(email)) {
          throw new Error('This email is already subscribed!');
        }
        
        subscribers.push(email);
        localStorage.setItem('mockSubscribers', JSON.stringify(subscribers));
        
        // Show success message
        messageDiv.textContent = '🎉 Success! Check your email to confirm your subscription.';
        messageDiv.className = 'form-message mt-3 p-3 rounded-lg text-sm font-semibold bg-green-100 text-green-800';
        messageDiv.classList.remove('hidden');
        
        // Reset form
        form.reset();
        
        // Log for demo purposes
        console.log('Newsletter subscription (mock):', email);
        console.log('Total subscribers:', subscribers.length);
        
      } catch (error) {
        // Show error message
        messageDiv.textContent = error.message || 'Something went wrong. Please try again.';
        messageDiv.className = 'form-message mt-3 p-3 rounded-lg text-sm font-semibold bg-red-100 text-red-800';
        messageDiv.classList.remove('hidden');
      } finally {
        // Reset button state
        button.disabled = false;
        button.textContent = originalButtonText;
      }
    });
  });
</script>

<style>
  .newsletter-form input:focus {
    transform: scale(1.01);
    transition: transform 0.2s ease;
  }
</style>