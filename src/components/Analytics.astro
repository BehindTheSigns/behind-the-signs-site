---
// GA4 loader. Renders nothing until PUBLIC_GA_MEASUREMENT_ID is set
// (Netlify -> Environment variables), so no placeholder ID ever ships.
const id = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

{
  id && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
      <script is:inline define:vars={{ id }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', id);
      </script>
    </>
  )
}
