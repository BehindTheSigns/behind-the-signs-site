---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/podcast', label: 'Podcast' },
  { href: '/about', label: 'About' },
  { href: '/resources', label: 'Resources' },
  { href: '/community', label: 'Community' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header id="main-header" class="sticky top-0 z-50 bg-white shadow-sm border-b border-slate-200">
  <nav class="container-custom">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <a href="/" class="sr-only">Behind the Signs</a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center space-x-1 ml-auto">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`nav-link px-3 py-2 text-sm font-medium tracking-wide uppercase transition-all duration-200 rounded-lg hover:bg-slate-100 ${
              currentPath === item.href ? 'text-pink-500' : 'text-slate-700'
            }`}
            data-active={currentPath === item.href ? 'true' : 'false'}
          >
            {item.label}
          </a>
        ))}
        <button class="ml-4 btn-primary text-sm px-5 py-2">
          Subscribe
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 text-slate-700 hover:text-pink-500 transition-colors mobile-menu-btn">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden lg:hidden pb-4 border-t border-white/10 mt-2 pt-4">
      <div class="flex flex-col space-y-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`mobile-nav-link px-4 py-3 text-sm font-medium tracking-wide uppercase transition-all duration-200 rounded-lg hover:bg-slate-100 ${
              currentPath === item.href ? 'text-pink-500 bg-pink-50' : 'text-slate-700'
            }`}
          >
            {item.label}
          </a>
        ))}
        <button class="btn-primary w-full mt-4">
          Subscribe
        </button>
      </div>
    </div>
  </nav>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
